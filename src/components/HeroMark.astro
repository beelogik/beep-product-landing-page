---
import LogoAnimated from "../assets/b-logo-qr-w-text-animated.svg";
---
<a href="#how" class="hero-mark" aria-label="See how Beep moves money from Pix (BRL) to RMB (CNY)">
  <span class="hero-mark__glow" aria-hidden="true"></span>
  <span>
    <span class="hero-mark__scale">
      <LogoAnimated class="h-[22rem] w-auto md:h-[36rem]" />
    </span>
  </span>
</a>

<script is:inline>
  // ensuring prefers-reduced-motion is respected, so strip the breathing manually
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.hero-mark animate').forEach((animation) => animation.remove());
  }
</script>

<style>
  .hero-mark {
    position: relative; display: inline-block; padding: 2rem; border-radius: 2rem;
    outline: none; cursor: pointer; -webkit-tap-highlight-color: transparent; touch-action: manipulation;
  }
  .hero-mark:focus-visible { outline: 2px solid var(--ring); outline-offset: 8px; }

  .hero-mark__glow {
    position: absolute; inset: -25% -25%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgba(241, 88, 10, .2), transparent 50%);
    filter: blur(32px);
    animation: breathe 6s ease-in-out infinite;
  }
  .hero-mark__scale {
    display: block;
    transition: transform var(--t), filter var(--t);
    filter: drop-shadow(0 30px 60px rgba(241, 88, 10, .35));
  }

  @media (hover: hover) {
    .hero-mark:hover .hero-mark__scale {
      transform: scale(1.04);
      filter: drop-shadow(0 40px 80px rgba(255, 158, 44, .5));
    }
  }
  .hero-mark:focus-visible .hero-mark__scale {
    transform: scale(1.04);
    filter: drop-shadow(0 40px 80px rgba(255, 158, 44, .5));
  }
  .hero-mark:active .hero-mark__scale { transform: scale(.985); }

  @keyframes breathe {
    0%, 100% { opacity: .7; transform: scale(.95); }
    50%      { opacity: 1;  transform: scale(1.25); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-mark__glow { animation: none; }
  }
</style>
