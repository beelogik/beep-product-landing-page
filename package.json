{
  "name": "beep-product-landing-page",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro:check": "astro check",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint .",
    "biome:check": "biome check --css-parse-tailwind-directives=true .",
    "biome:fix": "biome check --write --css-parse-tailwind-directives=true .",
    "biome:upgrade": "biome migrate --write",
    "prepare:commit": "lefthook install"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.3",
    "basecoat-css": "^1.0.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "latest",
    "lefthook": "^2.1.14"
  },
  "peerDependencies": {
    "typescript": "^6"
  }
}
